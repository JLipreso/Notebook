# Dependencies
node_modules/
.pnpm-store/
vendor/

# Build output
dist/
dist-ssr/
.output/
*.tsbuildinfo

# Vite
.vite/

# Environment files — .env.example templates ARE committed (they feed the env-var reference)
.env
.env.local
.env.*.local
.env.prod

# Laravel
/backend/storage/*.key
/backend/public/storage
/backend/public/hot
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
!.gitignore

# Claude Code — personal settings stay local, everything else in .claude/ is shared
.claude/settings.local.json

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/

# Credentials — NEVER commit (D-031, CLAUDE.md §7). The Firebase service-account
# JSON lives OUTSIDE the repo; backend/.env points at it by absolute path.
# These patterns are a safety net, not the mechanism.
*service-account*.json
*serviceaccount*.json
*adminsdk*.json
google-services.json
GoogleService-Info.plist
