# @notebook/student-browser — copy to .env for local dev. Committed as the template
# that feeds documents/0000-00-00-000-Memory/003-Env-Vars-Reference.md (run
# /refresh-docs in the same commit as any change here).

# Laravel API base URL (dev backend: php artisan serve)
VITE_API_URL=http://127.0.0.1:8000/api

# THE datasource switch (CLAUDE.md §3): 'true' = mock db, anything else = live API.
# Read ONLY by packages/services/datasource.ts.
VITE_USE_MOCK=true

# Demo/test-user affordances (CLAUDE.md §4) — must be 'false' against production auth.
VITE_DEMO_MODE=false

# Firebase web app config (public identifiers, safe to commit as placeholders) — D-015
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Pusher Channels (D-007)
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1
