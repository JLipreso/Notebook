APP_NAME=Notebook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# sqlite is the day-zero default (zero setup, fine for smoke tests). The
# production database engine is an open Lead-Developer decision (Q-001 ff.) —
# when it lands, record it in .claude/memory/decisions.md and switch here.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=notebook
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ================================================================
# Notebook (2026-09-12-002)
# ================================================================

# Deliberately blank — stateless bearer tokens only (CLAUDE.md §5).
SANCTUM_STATEFUL_DOMAINS=

# Comma-separated list; when set it REPLACES the dev defaults in
# config/cors.php. Production sets its exact origins here.
# CORS_ALLOWED_ORIGINS=

# ================================================================
# FIREBASE (2026-09-13-005 Phase 004) — D-015
# ================================================================

# NEVER commit the service-account JSON itself — store it OUTSIDE the repo and
# point this at it. On Windows use BACKSLASHES and NO quotes: kreait detects an
# absolute Windows path by looking for ':\', so 'C:/...' is treated as relative
# to the app root and fails; quoting it makes dotenv read '\c' as an escape.
# Absolute path to the Firebase service-account JSON, used to verify client ID tokens (Phase 004)
FIREBASE_CREDENTIALS=C:\credentials\notebook-firebase.json

# Firebase project id — must match the service-account's project and VITE_FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=your-firebase-project-id
