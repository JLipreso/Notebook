{
  "name": "notebook",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "description": "Notebook — digital notebooks + lightweight classroom layer for Philippine students (W Labs)",
  "scripts": {
    "dev:backend": "cd backend && php artisan serve",
    "dev:student:browser": "pnpm --filter @notebook/student-browser dev",
    "dev:student:mobile": "pnpm --filter @notebook/student-mobile dev",
    "build:student:browser": "pnpm --filter @notebook/student-browser build",
    "build:student:mobile": "pnpm --filter @notebook/student-mobile build",
    "build:all": "pnpm -r --filter \"./apps/*/*\" build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
